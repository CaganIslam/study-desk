{
  "type": "object",
  "properties": {
    "kind": {"type": "string", "enum": ["answer", "action"]},
    "answer_md": {"type": "string"},
    "terms": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "term": {"type": "string"},
          "meaning": {"type": "string"},
          "definition_en": {"type": "string"},
          "example": {"type": "string"}
        },
        "required": ["term", "meaning", "definition_en", "example"]
      }
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["none", "open", "goto_slide", "next", "prev", "set_level", "variant", "know_skip", "home", "resume", "today_summary", "search", "live"]},
        "query": {"type": "string"},
        "course": {"type": "string"},
        "lecture": {"type": "string"},
        "label": {"type": "string"},
        "level": {"type": "string", "enum": ["short", "normal", "detailed"]},
        "variant": {"type": "string", "enum": ["simpler", "example", "different", "formula"]}
      },
      "required": ["type"]
    }
  },
  "required": ["kind", "answer_md", "terms", "action"]
}
